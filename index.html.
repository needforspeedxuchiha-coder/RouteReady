<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#164e43">
  <title>RouteReady | Campus Navigation</title>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f7f5;
      color: #183b32;
    }

    header {
      background: #164e43;
      color: white;
      padding: 28px 22px 34px;
    }

    .brand {
      font-size: 25px;
      font-weight: bold;
      margin: 0 0 8px;
    }

    .tagline {
      font-size: 12px;
      letter-spacing: 2px;
      color: #d8eee5;
    }

    header h2 {
      margin-top: 30px;
      font-size: 27px;
      line-height: 1.25;
    }

    header p {
      line-height: 1.6;
      color: #e0eee8;
    }

    main {
      width: 100%;
      max-width: 600px;
      padding: 24px 18px 40px;
      margin: auto;
    }

    .eyebrow {
      font-size: 12px;
      font-weight: bold;
      color: #557267;
      letter-spacing: 1px;
    }

    .room {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 18px;
      margin: 14px 0;
      border: 1px solid #dce8e1;
      border-radius: 15px;
      background: white;
      color: #183b32;
      text-align: left;
      cursor: pointer;
    }

    .roomIcon {
      font-size: 26px;
      background: #e5f1eb;
      padding: 12px;
      border-radius: 12px;
    }

    .roomInfo { flex: 1; }

    .roomInfo strong {
      display: block;
      font-size: 16px;
      margin-bottom: 6px;
    }

    .roomInfo small { color: #62756c; }

    .arrow {
      font-size: 24px;
      color: #164e43;
    }

    .room:active { background: #e8f2ec; }

    #destinationPage { display: none; }

    .back {
      border: none;
      background: #164e43;
      color: white;
      padding: 12px 16px;
      border-radius: 9px;
      font-size: 15px;
      margin-bottom: 20px;
      cursor: pointer;
    }

    .placeholder {
      background: white;
      border: 1px solid #dce8e1;
      border-radius: 16px;
      padding: 40px 20px;
      text-align: center;
      margin-top: 20px;
    }

    .placeholderIcon { font-size: 45px; }

    .placeholder p {
      line-height: 1.6;
      color: #62756c;
    }

    footer {
      text-align: center;
      padding: 20px;
      font-size: 12px;
      color: #62756c;
    }
  </style>
</head>

<body>
  <header>
    <div class="brand">⌖ RouteReady</div>
    <div class="tagline">SCAN. SELECT. FOLLOW.</div>
    <h2>Find your way around campus.</h2>
    <p>Choose your destination and get ready to find your route.</p>
  </header>

  <main>
    <section id="menuPage">
      <div class="eyebrow">YOUR CAMPUS GUIDE</div>
      <h2>Where do you want to go?</h2>
      <p>Select a destination to explore the route.</p>

      <button class="room" onclick="openDestination('Tutorial Room')">
        <span class="roomIcon">📚</span>
        <span class="roomInfo">
          <strong>Tutorial Room</strong>
          <small>Find your classroom</small>
        </span>
        <span class="arrow">›</span>
      </button>

      <button class="room" onclick="openDestination('Lecture Hall')">
        <span class="roomIcon">🎓</span>
        <span class="roomInfo">
          <strong>Lecture Hall</strong>
          <small>Find your lecture venue</small>
        </span>
        <span class="arrow">›</span>
      </button>

      <button class="room" onclick="openDestination('Faculty Office')">
        <span class="roomIcon">🏢</span>
        <span class="roomInfo">
          <strong>Faculty Office</strong>
          <small>Find the faculty office</small>
        </span>
        <span class="arrow">›</span>
      </button>
    </section>

    <section id="destinationPage">
      <button class="back" onclick="goBack()">
        ← Back to destinations
      </button>

      <div class="eyebrow">YOUR DESTINATION</div>
      <h2 id="destinationTitle">Tutorial Room</h2>

      <div class="placeholder">
        <div class="placeholderIcon">🎬</div>
        <h3>Route video coming soon</h3>
        <p>
          The walking route video for this destination
          will be available here.
        </p>
      </div>
    </section>
  </main>

  <footer>
    RouteReady · Campus navigation made easier
  </footer>

  <script>
    function openDestination(name) {
      document.getElementById("menuPage").style.display = "none";
      document.getElementById("destinationPage").style.display = "block";
      document.getElementById("destinationTitle").textContent = name;
      window.scrollTo(0, 0);
    }

    function goBack() {
      document.getElementById("destinationPage").style.display = "none";
      document.getElementById("menuPage").style.display = "block";
      window.scrollTo(0, 0);
    }
  </script>
</body>
</html>
